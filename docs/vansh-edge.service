# Starts the VANSH bridge with the computer (Linux, Raspberry Pi).
#
#   1. Change User and the two paths below to match where you put the vansh folder.
#   2. sudo cp docs/vansh-edge.service /etc/systemd/system/
#   3. sudo systemctl enable --now vansh-edge
#   4. journalctl -u vansh-edge -f      shows what it is doing
[Unit]
Description=VANSH bridge at the nets
Wants=network-online.target
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/vansh
ExecStart=/home/pi/vansh/.venv/bin/python -m crickcoach.edge run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
