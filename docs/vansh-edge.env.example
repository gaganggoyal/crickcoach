# Settings for the VANSH bridge at the nets. Copy this file to vansh-edge.env
# in the vansh folder and fill it in. It holds passwords: keep it private.

# The VANSH server, and the coach key that unlocks it.
VANSH_SERVER=https://vansh.best
VANSH_COACH_KEY=

# The cameras' RTSP addresses. The builder at https://vansh.best/setup/ writes these lines.
# Leave VANSH_BEHIND_URL empty if there is only a side-on camera.
VANSH_SIDE_URL=rtsp://vansh:password@192.168.1.20:554/Streaming/Channels/101
VANSH_BEHIND_URL=rtsp://vansh:password@192.168.1.21:554/Streaming/Channels/101

# Length of each take in seconds (30 to 600).
VANSH_TAKE_SECONDS=90

# Stop recording if this many GB of takes are waiting to upload.
VANSH_EDGE_MAX_GB=20

# The bowling machine, for "python -m crickcoach.edge machine --armed".
# VANSH_MACHINE_ADDRESS=192.168.1.50:8520
